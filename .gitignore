# 虚拟环境
venv/
.venv/

# Python 缓存
__pycache__/
*.py[cod]
*$py.class
*.so

# 分发/打包
dist/
build/
*.egg-info/
*.egg

# IDE
.idea/
.vscode/
*.swp
*.swo

# 日志文件
logs/
*.log

# 测试
.pytest_cache/
.coverage
htmlcov/

# 系统文件
.DS_Store
Thumbs.db

# 配置文件（可能包含敏感信息）
config.local.yaml

# 模型文件（大文件）
models/*.gguf
models/*.onnx
models/*.bin

# llama.cpp 二进制文件
llama-b9969/
cudart-12.4/
*.exe
ggml*.dll
llama*.dll
llava*.dll

# 压缩包
*.zip
*.tar.gz
*.7z

# 项目级 Codex 配置（可能包含 API Key 等敏感信息）
.codex/
venv-paddle/

# 会话级产物（ZCode 计划文件等，不入库）
.zcode/

# 本地导出的临时文档
知乎热榜报告-*.md
